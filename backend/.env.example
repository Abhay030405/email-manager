# CampaignX Backend Environment Variables
# ============================================================================
# AI & LLM Configuration
# ============================================================================

# OpenAI API Key (required)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI Model Configuration
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000

# LangChain Configuration
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=campaignx

# ============================================================================
# Database Configuration
# ============================================================================

# MongoDB Connection String
# Local: mongodb://localhost:27017/campaignx
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_URI=mongodb://localhost:27017/campaignx

# Database Name
DATABASE_NAME=campaignx

# MongoDB Connection Pool Settings
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_POOL_SIZE=50

# ============================================================================
# External API Configuration - Mock Campaign API
# ============================================================================

# Mock Campaign API Base URL
# Production: https://mock-campaign-api.onrender.com
# Local (if running mock API locally): http://localhost:8000
MOCK_CAMPAIGN_API_URL=https://mock-campaign-api.onrender.com

# Timeout for Mock API requests (seconds)
# Set higher (60s) to handle cold starts on free tier
MOCK_API_TIMEOUT=60

# Retry Configuration for Mock API
MOCK_API_MAX_RETRIES=3
MOCK_API_RETRY_DELAY=5

# ============================================================================
# Application Configuration
# ============================================================================

# Application Environment
# Options: development, staging, production
ENVIRONMENT=development

# FastAPI Server Configuration
HOST=0.0.0.0
PORT=8000

# API Configuration
API_V1_PREFIX=/api/v1
API_TITLE=CampaignX API
API_VERSION=1.0.0
API_DESCRIPTION=AI Multi-Agent Marketing Automation Platform

# ============================================================================
# Security Configuration
# ============================================================================

# Secret Key for JWT tokens (generate a secure random string)
# Generate with: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-minimum-32-characters-long

# Algorithm for JWT encoding
ALGORITHM=HS256

# Token expiration time (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# CORS Configuration
# ============================================================================

# Allowed origins for CORS — must be a JSON array
# Development: ["http://localhost:5173","http://localhost:3000"]
# Production:  ["https://yourdomain.com"]
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# CORS credentials support
ALLOW_CREDENTIALS=true

# Allowed HTTP methods — must be a JSON array
ALLOWED_METHODS=["GET","POST","PUT","DELETE","PATCH","OPTIONS"]

# Allowed headers — must be a JSON array
ALLOWED_HEADERS=["*"]

# ============================================================================
# Logging Configuration
# ============================================================================

# Log Level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log Format
# Options: json, text
LOG_FORMAT=text

# Log File Path (optional)
LOG_FILE_PATH=logs/campaignx.log

# Log Rotation
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5

# ============================================================================
# Agent Configuration
# ============================================================================

# Agent Execution Timeout (seconds)
AGENT_TIMEOUT=300

# Maximum retries for agent execution
AGENT_MAX_RETRIES=3

# LangGraph Checkpointing
LANGGRAPH_CHECKPOINT_ENABLED=true
LANGGRAPH_CHECKPOINT_TTL=86400  # 24 hours in seconds

# ============================================================================
# Campaign Configuration
# ============================================================================

# Maximum customers per campaign
MAX_CUSTOMERS_PER_CAMPAIGN=10000

# Maximum variants per campaign
MAX_VARIANTS_PER_CAMPAIGN=10

# Default campaign retention period (days)
CAMPAIGN_RETENTION_DAYS=90

# ============================================================================
# Optimization Engine Configuration
# ============================================================================

# Optimization score weights
OPTIMIZATION_CLICK_WEIGHT=0.7
OPTIMIZATION_OPEN_WEIGHT=0.3

# Performance threshold for optimization (percentage)
OPTIMIZATION_THRESHOLD=25  # Bottom 25% performers

# Minimum samples before optimization
MIN_SAMPLES_FOR_OPTIMIZATION=100

# ============================================================================
# Rate Limiting Configuration
# ============================================================================

# API Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000

# ============================================================================
# Caching Configuration (Future - Redis)
# ============================================================================

# Redis Configuration (optional, for future implementation)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CACHE_TTL=3600  # 1 hour in seconds

# ============================================================================
# Email Configuration (Future - for notifications)
# ============================================================================

# SMTP Configuration (optional, for future implementation)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@campaignx.com
SMTP_FROM_NAME=CampaignX Platform

# ============================================================================
# Monitoring & Observability (Future)
# ============================================================================

# Sentry Configuration (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================================================
# Testing Configuration
# ============================================================================

# Test Database (use separate database for tests)
TEST_DATABASE_NAME=campaignx_test

# Mock Mode for Testing
MOCK_MODE=false

# ============================================================================
# Development Tools
# ============================================================================

# Enable API documentation
ENABLE_DOCS=true

# Enable hot reload (development only)
RELOAD=true

# Debug mode (development only)
DEBUG=true

# ============================================================================
# Production Configuration (when ENVIRONMENT=production)
# ============================================================================

# Gunicorn workers (production deployment)
WEB_CONCURRENCY=4

# Uvicorn workers
UVICORN_WORKERS=4

# ============================================================================
# Feature Flags
# ============================================================================

# Enable/disable specific features
FEATURE_WEB_SEARCH=false
FEATURE_REAL_TIME_METRICS=true
FEATURE_AUTO_OPTIMIZATION=true
FEATURE_AB_TESTING=true

# ============================================================================
# Notes:
# ============================================================================
# 1. Generate SECRET_KEY: openssl rand -hex 32
# 2. For production, set ENVIRONMENT=production
# 3. Use strong, unique passwords for MongoDB
# 4. Set MOCK_API_TIMEOUT=60 to handle cold starts
# 5. Configure ALLOWED_ORIGINS for your frontend domain
# 6. Enable LANGCHAIN_TRACING_V2 for debugging agent workflows
# 7. Consider using MongoDB Atlas for production database
# 8. Set up proper logging in production (file-based with rotation)
# ============================================================================